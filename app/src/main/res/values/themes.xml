<resources>
    <style name="Theme.WifiDrop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/qetara_background</item>
    </style>

    <style name="Theme.WifiDrop.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/qetara_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_qetara_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/qetara_background</item>
        <item name="postSplashScreenTheme">@style/Theme.WifiDrop</item>
    </style>
</resources>
